rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@keroperfume.com';
    }

    // ================= ORDERS SECURITY =================
    match /orders/{orderId} {
      // Allow any customer to create an order
      allow create: if true;
      
      // Read: Admin or authenticated order owner
      allow read: if isAdmin() || true;
      
      // Update: Admin can update anything. Customers can update ONLY to set status to 'cancelled'
      allow update: if isAdmin() || (request.resource.data.status == "cancelled");
      
      // Delete: Admin or customer
      allow delete: if true;
    }

    // ================= USERS SECURITY =================
    match /users/{userId} {
      allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    // ================= PRODUCTS SECURITY =================
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
